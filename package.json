{
  "name": "health-management-website",
  "version": "1.0.0",
  "description": "健康管理中心官方网站",
  "main": "index.html",
  "scripts": {
    "dev": "wrangler pages dev . --port 8788",
    "dev:static": "live-server",
    "proxy": "node proxy-server.js",
    "build": "echo 'Static site - no build needed'",
    "start": "npm run dev",
    "cf:dev": "wrangler dev",
    "deploy:pages": "wrangler pages deploy . --project-name=health-management --branch=main",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-ai-hardening.js && node scripts/test-context-budget.js"
  },
  "keywords": [
    "health",
    "management",
    "website",
    "static"
  ],
  "author": "健康科技",
  "license": "MIT",
  "devDependencies": {
    "live-server": "^1.2.2",
    "wrangler": "^4.131.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.44.4",
    "node-fetch": "^2.7.0"
  }
}
